$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@Caption = Label {
  Anchor: (Bottom: 6, Horizontal: 4);
  Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #96a9be, RenderUppercase: true);
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 680);

    #Title {
      $C.@Title {
        @Text = %e4hytale.ui.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);

      Label #State {
        Anchor: (Bottom: 14, Horizontal: 4);
        Style: (...$C.@DefaultLabelStyle, FontSize: 20, TextColor: #ffffff);
      }

      @Caption {
        Text: %e4hytale.ui.addressCaption;
      }

      Group #AddressRow {
        LayoutMode: Left;
        Anchor: (Bottom: 6, Height: 40);

        // read-only, so the address can be selected and copied but not changed by accident
        Group #AddressBox {
          FlexWeight: 1;
          Anchor: (Right: 8);
          LayoutMode: Top;
          Background: (Color: $C.@ColorBackgroundCode);

          CodeEditor #Address {
            FlexWeight: 1;
            Style: (TextColor: #ffffff, FontSize: 16);
            // small enough that one line fits the row, a taller line makes the editor scroll (and show a scrollbar)
            ContentPadding: 6;
            IsReadOnly: true;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }

        $C.@TextButton #CopyButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Width: 120);
          Text: %e4hytale.ui.copy;
        }
      }

      Label #CopyHint {
        Anchor: (Bottom: 10, Horizontal: 4);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #878e9c, Wrap: true);
      }

      // New address asks first: friends who saved the old address can't use it any more
      Group #AddressActions {
        LayoutMode: Left;
        Anchor: (Bottom: 16, Height: 36);

        $C.@SecondaryTextButton #NewAddressButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Width: 200);
          Text: %e4hytale.ui.newAddress;
        }

        Group #NewAddressConfirm {
          LayoutMode: Left;
          FlexWeight: 1;
          Visible: false;

          Label {
            FlexWeight: 1;
            Anchor: (Right: 8, Left: 4);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #E8A93B, Wrap: true, VerticalAlignment: Center);
            Text: %e4hytale.ui.newAddressWarning;
          }

          $C.@TextButton #ConfirmNewAddressButton {
            @Sounds = $Sounds.@SaveSettings;
            @Anchor = (Width: 170, Right: 6);
            Text: %e4hytale.ui.newAddressConfirm;
          }

          $C.@SecondaryTextButton #KeepAddressButton {
            @Sounds = $Sounds.@ButtonsCancel;
            @Anchor = (Width: 120);
            Text: %e4hytale.ui.newAddressKeep;
          }
        }
      }

      Label #Relay {
        Anchor: (Bottom: 16, Horizontal: 4);
        Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true);
      }

      Label #PlayersCaption {
        Anchor: (Bottom: 6, Horizontal: 4);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #96a9be, RenderUppercase: true);
      }

      Group #Players {
        Anchor: (Height: 140, Bottom: 16);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Label #PlayerList {
          Anchor: (Horizontal: 4);
          Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #c9d1d9, Wrap: true);
        }
      }

      Group #Buttons {
        LayoutMode: Center;
        Anchor: (Height: 44);

        $C.@TextButton #StartButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Width: 190, Right: 6);
          Text: %e4hytale.ui.start;
        }

        $C.@SecondaryTextButton #StopButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Width: 190, Right: 6);
          Text: %e4hytale.ui.stop;
        }

        $C.@SecondaryTextButton #AutoOnButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Width: 230, Left: 6, Right: 6);
          Text: %e4hytale.ui.autoOff;
        }

        $C.@SecondaryTextButton #AutoOffButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Width: 230, Left: 6, Right: 6);
          Text: %e4hytale.ui.autoOn;
        }

        $C.@SecondaryTextButton #CloseButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Width: 140, Left: 6);
          Text: %e4hytale.ui.close;
        }
      }
    }
  }
}

$C.@BackButton {}
